# --- TigerGraph ---
TG_HOST=https://tgcloud.io/groups/<your-workspace-id>
TG_USERNAME=tigergraph
TG_PASSWORD=<password>
TG_SECRET=<optional-secret-for-token-auth>
TG_GRAPH_NAME=FraudGraph

# --- LLM (optional; SAR narratives fall back to a template without it) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- API security ---
# JSON map of bearer token -> analyst. When set, every /api route except /health requires
#   Authorization: Bearer <token>
# and the analyst name/role come from the token. When empty the API runs in DEV MODE (no auth).
# Generate tokens with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ANALYST_TOKENS=
# Example: ANALYST_TOKENS={"<token1>": {"name": "Sarah Lin", "role": "L1"}, "<token2>": {"name": "Ravi Patel", "role": "L2"}}

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
