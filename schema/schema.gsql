USE GLOBAL

DROP ALL

CREATE VERTEX Customer (
    PRIMARY_ID customer_id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX Card (
    PRIMARY_ID card_id STRING,
    card4 STRING,
    card6 STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX Transaction (
    PRIMARY_ID txn_id STRING,
    ts DATETIME,
    amount DOUBLE,
    product_cd STRING,
    channel STRING,
    risk_score DOUBLE,
    addr1 STRING,
    addr2 STRING,
    card1 STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX DeviceProfile (
    PRIMARY_ID device_id STRING,
    device_info STRING,
    os STRING,
    browser STRING,
    screen_res STRING,
    device_type STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX EmailDomain (
    PRIMARY_ID domain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX BillingRegion (
    PRIMARY_ID region_code STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX ClosedCase (
    PRIMARY_ID case_id STRING,
    outcome STRING,
    pattern STRING,
    exposure_usd DOUBLE,
    opened_at DATETIME,
    closed_at DATETIME,
    actions_taken STRING,
    report_filed STRING,
    analyst_notes STRING,
    n_txns INT
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile, id_15 STRING) WITH REVERSE_EDGE="DEVICE_USED_IN"
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="EMAIL_USED_IN"
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_HAS"
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, delta_seconds DOUBLE) WITH REVERSE_EDGE="PREV"
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN"
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="HAS_CASE"
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CONNECTED_FROM"

CREATE GRAPH FraudGraph (
    Customer, Card, Transaction, DeviceProfile, EmailDomain, BillingRegion, ClosedCase,
    OWNS, MADE, FROM_DEVICE, PURCHASER_EMAIL, BILLED_IN, NEXT,
    INVOLVES, ON_CARD, CONNECTED_TO
)
